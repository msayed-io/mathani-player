{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mathani",
  "version": "1.0.0",
  "identifier": "com.msayed.mathani",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مثاني — الجزيرة التفاعلية",
        "width": 1920,
        "height": 420,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "player",
        "title": "مثاني — مشغل القرآن الكريم",
        "url": "player.html",
        "width": 1140,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "focus": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "إعدادات مثاني",
        "url": "settings.html",
        "width": 660,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "focus": true,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: http://quran.localhost https://quran.localhost quran:; media-src 'self' data: blob: http://quran.localhost https://quran.localhost quran: asset: http://asset.localhost; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://quran.localhost https://quran.localhost quran: https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co http://ip-api.com"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "publisher": "Mathani Project",
    "copyright": "Copyright © 2026 Mathani (GPL-3.0)",
    "category": "Education",
    "shortDescription": "مثاني — مشغل القرآن الكريم لسطح مكتب ويندوز مع الجزيرة التفاعلية",
    "longDescription": "مشغل قرآن كريم احترافي لملفات التلاوة المحلية على ويندوز، متكامل مع الجزيرة التفاعلية (Dynamic Island) في أعلى الشاشة.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
